# Server Environment Variables
# Copy this file to .env and fill in your values

NODE_ENV=development
PORT=5000

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
# Get this from: https://cloud.mongodb.com → Connect → Drivers
# Replace <user>, <password>, <cluster> with your actual values
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/interview-tracker?retryWrites=true&w=majority

# ─── Clerk Auth ───────────────────────────────────────────────────────────────
# Get these from: https://dashboard.clerk.com → Your App → API Keys
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME

# ─── App Config ───────────────────────────────────────────────────────────────
# Client origin (for CORS)
CLIENT_URL=http://localhost:5173

# Hour (0-23) in UTC when the daily deadline closes
# Default 18 = 11:30 PM IST (UTC+5:30)
DEADLINE_HOUR_UTC=18
